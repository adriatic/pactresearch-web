# Copy this file to .env.local and fill in the values below.
#
# THE THREE VARIABLES BELOW ARE REQUIRED. next.config.ts refuses to build
# or to start the dev server without them, naming the one that is missing
# (task 66). lib/requiredEnv.ts is the list this file mirrors; if you add
# a variable the app cannot run without, add it in both places.
#
# IMPORTANT: NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY here
# must point at your LOCAL Supabase instance (from `npx supabase status`),
# not the hosted/production project. Pasting hosted credentials into
# .env.local means every "local" login, test, and dev-server run silently
# happens against real production data instead — this has already caused a
# real bug once (a "local" login that was actually a real login against
# production). If you're not sure which project a URL/key belongs to: the
# local one is always http://127.0.0.1:54321 with the fixed local anon key
# below; anything else is not local.

# --- Required -------------------------------------------------------

# From `npx supabase status` (local dev stack — see supabase/config.toml).
# These exact values are Supabase's standard fixed local dev credentials,
# the same for every `supabase start` on every machine — not a secret.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Real secret. AES-256-GCM key for the third-party API keys this app
# stores on a user's behalf (lib/apiKeyCrypto.ts). Must be base64 that
# decodes to exactly 32 bytes; generate your own with:
#
#     openssl rand -base64 32
#
# Each environment needs its OWN value, and rotating it makes every key
# already stored in that environment unreadable — users just re-enter
# theirs. Deleting it from Vercel is what caused the 2026-09-27 outage,
# which is why the build now refuses to proceed without it.
API_KEY_ENCRYPTION_SECRET=generate-your-own-with-openssl-rand-base64-32

# --- Optional -------------------------------------------------------

# Analytics. instrumentation-client.ts skips PostHog entirely when the
# token is absent, so leaving these unset is a supported configuration.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# NEXT_PUBLIC_POSTHOG_HOST=

# --- Deliberately NOT here -------------------------------------------
#
# ANTHROPIC_API_KEY used to live in this file and is no longer read by
# any application code: since task 51 each user supplies their own key,
# stored encrypted with API_KEY_ENCRYPTION_SECRET above. It is listed
# here only so nobody re-adds it thinking it went missing, and so the
# variable that DID matter is not confused with the one that did not.
